                "@DataIntegration.dataUnavailable": true,
                "@ObjectModel.foreignKey.association": "_GLAccountInChartOfAccounts",
                "key": true,
                "type": "cds.String",
                "length": 10
              },
              "Customer": {
                "@Analytics.dimension": true,
                "@EndUserText.label": "Customer",
                "@EndUserText.heading": "Customer",
                "@EndUserText.quickInfo": "Customer Number",
                "@DataIntegration.dataUnavailable": true,
                "@PersonalData.isPotentiallyPersonal": true,
                "key": true,
                "type": "cds.String",
                "length": 10
              },
              "Supplier": {
                "@Analytics.dimension": true,
                "@EndUserText.label": "Supplier",
                "@EndUserText.heading": "Supplier",
                "@EndUserText.quickInfo": "Supplier",
                "@DataIntegration.dataUnavailable": true,
                "@PersonalData.isPotentiallyPersonal": true,
                "key": true,
                "type": "cds.String",
                "length": 10
              },
              "ProfitCenter": {
                "@Analytics.dimension": true,
                "@EndUserText.label": "Profit Center",
                "@EndUserText.heading": "Profit Center",
                "@EndUserText.quickInfo": "Profit Center",
                "@DataIntegration.dataUnavailable": true,
                "key": true,
                "type": "cds.String",
                "length": 10
              },
              "CostCenter": {
                "@Analytics.dimension": true,
                "@EndUserText.label": "Cost Center",
                "@EndUserText.heading": "Cost Center",
                "@EndUserText.quickInfo": "Cost Center",
                "@DataIntegration.dataUnavailable": true,
                "key": true,
                "type": "cds.String",
                "length": 10
              },
              "CompanyCodeCurrency": {
                "@Analytics.dimension": true,
                "@EndUserText.label": "Company Code Currency",
                "@EndUserText.heading": "Company Code Currency",
                "@EndUserText.quickInfo": "Company Code Currency",
                "@DataIntegration.dataUnavailable": true,
                "key": true,
                "type": "cds.String",
                "length": 5
              },
              "TransactionCurrency": {
                "@Analytics.dimension": true,
                "@EndUserText.label": "Transaction Currency",
                "@EndUserText.heading": "Transaction Currency",
                "@EndUserText.quickInfo": "Transaction Currency",
                "@DataIntegration.dataUnavailable": true,
                "key": true,
                "type": "cds.String",
                "length": 5
              },
              "DebitCreditCode": {
                "@Analytics.dimension": true,
                "@EndUserText.label": "Debit/Credit Code",
                "@EndUserText.heading": "Debit/Credit Code",
                "@EndUserText.quickInfo": "Debit/Credit Code",
                "@DataIntegration.dataUnavailable": true,
                "key": true,
                "type": "cds.String",
                "length": 1,
                "enum": {
                  "values": {}
                }
              },
              "PostingDate": {
                "@Analytics.dimension": true,
                "@EndUserText.label": "Posting Date",
                "@EndUserText.heading": "Posting Date",
                "@EndUserText.quickInfo": "Posting Date",
                "@DataIntegration.dataUnavailable": true,
                "type": "cds.Date"
              },
              "NetDueDate": {
                "@Analytics.dimension": true,
                "@EndUserText.label": "Net Due Date",
                "@EndUserText.heading": "Net Due Dt",
                "@EndUserText.quickInfo": "Net Due Date",
                "@DataIntegration.dataUnavailable": true,
                "type": "cds.Date"
              },
              "ClearingDate": {
                "@Analytics.dimension": true,
                "@EndUserText.label": "Clearing Date",
                "@EndUserText.heading": "Clearing Date",
                "@EndUserText.quickInfo": "Clearing Date",
                "@DataIntegration.dataUnavailable": true,
                "type": "cds.Date"
              },
              "AccountingDocumentType": {
                "@Analytics.dimension": true,
                "@EndUserText.label": "Journal Entry Type",
                "@EndUserText.heading": "Journal Entry Type",
                "@EndUserText.quickInfo": "Journal Entry Type",
                "@DataIntegration.dataUnavailable": true,
                "type": "cds.String",
                "length": 2
              },
              "ChartOfAccounts": {
                "@Analytics.dimension": true,
                "@EndUserText.label": "Chart of Accounts",
                "@EndUserText.heading": "Chart of Accounts",
                "@EndUserText.quickInfo": "Chart of Accounts",
                "@DataIntegration.dataUnavailable": true,
                "@ObjectModel.foreignKey.association": "_ChartOfAccounts",
                "type": "cds.String",
                "length": 4
              },
              "AgingBucket": {
                "@Analytics.dimension": true,
                "@Core.Computed": true,
                "type": "cds.String",
                "length": 30
              },
              "TotalAmountInCompanyCodeCurrency": {
                "@Core.Computed": true,
                "type": "cds.Decimal",
                "precision": 34,
                "scale": 4
              },
              "AmountInCompanyCodeCurrencyCount": {
                "@Core.Computed": true,
                "type": "cds.Integer"
              },
              "TotalAmountInTransactionCurrency": {
                "@Core.Computed": true,
                "type": "cds.Decimal",
                "precision": 34,
                "scale": 4
              },
              "AmountInTransactionCurrencyCount": {
                "@Core.Computed": true,
                "type": "cds.Integer"
              },
              "LineItemCount": {
                "@Core.Computed": true,
                "type": "cds.Integer"
              }
            }
          }
        }
      },
      "authorization": {
        "definition": "POLICY \"WorkingCapital.v1.WorkingCapitalCube\" {\n  GRANT READ ON \"c.bdc.7p712k95j9gm6v0kj328bm8k5.WorkingCapital.v1.WorkingCapitalCube\" WHERE\n    c.bdc.7p712k95j9gm6v0kj328bm8k5.WorkingCapital.v1.WorkingCapitalCube.CompanyCode IS NOT RESTRICTED AND\n    c.bdc.7p712k95j9gm6v0kj328bm8k5.WorkingCapital.v1.WorkingCapitalCube.FinancialAccountType IS NOT RESTRICTED AND\n    c.bdc.7p712k95j9gm6v0kj328bm8k5.WorkingCapital.v1.WorkingCapitalCube.GLAccount IS NOT RESTRICTED AND\n    c.bdc.7p712k95j9gm6v0kj328bm8k5.WorkingCapital.v1.WorkingCapitalCube.ProfitCenter IS NOT RESTRICTED AND\n    c.bdc.7p712k95j9gm6v0kj328bm8k5.WorkingCapital.v1.WorkingCapitalCube.CostCenter IS NOT RESTRICTED AND\n    c.bdc.7p712k95j9gm6v0kj328bm8k5.WorkingCapital.v1.WorkingCapitalCube.PostingDate IS NOT RESTRICTED AND\n    c.bdc.7p712k95j9gm6v0kj328bm8k5.WorkingCapital.v1.WorkingCapitalCube.ChartOfAccounts IS NOT RESTRICTED AND\n    c.bdc.7p712k95j9gm6v0kj328bm8k5.WorkingCapital.v1.WorkingCapitalCube.FiscalYear IS NOT RESTRICTED AND\n    c.bdc.7p712k95j9gm6v0kj328bm8k5.WorkingCapital.v1.WorkingCapitalCube.FiscalYearPeriod IS NOT RESTRICTED AND\n    c.bdc.7p712k95j9gm6v0kj328bm8k5.WorkingCapital.v1.WorkingCapitalCube.Customer IS NOT RESTRICTED AND\n    c.bdc.7p712k95j9gm6v0kj328bm8k5.WorkingCapital.v1.WorkingCapitalCube.Supplier IS NOT RESTRICTED AND\n    c.bdc.7p712k95j9gm6v0kj328bm8k5.WorkingCapital.v1.WorkingCapitalCube.CompanyCodeCurrency IS NOT RESTRICTED AND\n    c.bdc.7p712k95j9gm6v0kj328bm8k5.WorkingCapital.v1.WorkingCapitalCube.TransactionCurrency IS NOT RESTRICTED AND\n    c.bdc.7p712k95j9gm6v0kj328bm8k5.WorkingCapital.v1.WorkingCapitalCube.DebitCreditCode IS NOT RESTRICTED AND\n    c.bdc.7p712k95j9gm6v0kj328bm8k5.WorkingCapital.v1.WorkingCapitalCube.NetDueDate IS NOT RESTRICTED AND\n    c.bdc.7p712k95j9gm6v0kj328bm8k5.WorkingCapital.v1.WorkingCapitalCube.ClearingDate IS NOT RESTRICTED AND\n    c.bdc.7p712k95j9gm6v0kj328bm8k5.WorkingCapital.v1.WorkingCapitalCube.AccountingDocumentType IS NOT RESTRICTED AND\n    c.bdc.7p712k95j9gm6v0kj328bm8k5.WorkingCapital.v1.WorkingCapitalCube.AgingBucket IS NOT RESTRICTED;\n}"
      }
    },
    "transformation": {
      "transformers": {
        "WorkingCapitalCubeTransformation": {
          "title": "Transformation for WorkingCapitalCube",
          "type": "sql-query",
          "inputs": [
            {
              "name": "sap.s4com:apiResource:GeneralLedgerAccount:v1.GeneralLedgerAccountLineItem"
            }
          ],
          "outputs": [
            {
              "name": "WorkingCapitalCube"
            }
          ],
          "definition": {
            "query": {
              "SELECT": {
                "from": {
                  "ref": [
                    "sap.s4com:apiResource:GeneralLedgerAccount:v1.GeneralLedgerAccountLineItem"
                  ],
                  "as": "I"
                },
                "columns": [
                  {
                    "key": true,
                    "ref": [
                      "I",
                      "CompanyCode"
                    ],
                    "as": "CompanyCode"
                  },
                  {
                    "key": true,
                    "ref": [
                      "I",
                      "FiscalYear"
                    ],
                    "as": "FiscalYear"
                  },
                  {
                    "key": true,
                    "ref": [
                      "I",
                      "FiscalYearPeriod"
                    ],
                    "as": "FiscalYearPeriod"
                  },
                  {
                    "xpr": [
                      {
                        "xpr": [
                          "case",
                          "when",
                          {
                            "ref": [
                              "I",
                              "FinancialAccountType"
                            ]
                          },
                          "=",
                          {
                            "val": "D"
                          },
                          "then",
                          {
                            "val": "Customer"
                          },
                          "when",
                          {
                            "ref": [
                              "I",
                              "FinancialAccountType"
                            ]
                          },
                          "=",
                          {
                            "val": "K"
                          },
                          "then",
                          {
                            "val": "Supplier"
                          },
                          "else",
                          {
                            "ref": [
                              "I",
                              "FinancialAccountType"
                            ]
                          },
                          "end"
                        ],
                        "cast": {
                          "type": "cds.String",
                          "length": 20
                        }
                      }
                    ],
                    "as": "FinancialAccountType"
                  },
                  {
                    "key": true,
                    "ref": [
                      "I",
                      "GLAccount"
                    ],
                    "as": "GLAccount"
                  },
                  {
                    "key": true,
                    "ref": [
                      "I",
                      "Customer"
                    ],
                    "as": "Customer"
                  },
                  {
                    "key": true,
                    "ref": [
                      "I",
                      "Supplier"
                    ],
                    "as": "Supplier"
                  },
                  {
                    "key": true,
                    "ref": [
                      "I",
                      "ProfitCenter"
                    ],
                    "as": "ProfitCenter"
                  },
                  {
                    "key": true,
                    "ref": [
                      "I",
                      "CostCenter"
                    ],
                    "as": "CostCenter"
                  },
                  {
                    "key": true,
                    "ref": [
                      "I",
                      "CompanyCodeCurrency"
                    ],
                    "as": "CompanyCodeCurrency"
                  },
                  {
                    "key": true,
                    "ref": [
                      "I",
                      "TransactionCurrency"
                    ],
                    "as": "TransactionCurrency"
                  },
                  {
                    "key": true,
                    "ref": [
                      "I",
                      "DebitCreditCode"
                    ],
                    "as": "DebitCreditCode"
                  },
                  {
                    "ref": [
                      "I",
                      "PostingDate"
                    ],
                    "as": "PostingDate"
                  },
                  {
                    "ref": [
                      "I",
                      "NetDueDate"
                    ],
                    "as": "NetDueDate"
                  },
                  {
                    "ref": [
                      "I",
                      "ClearingDate"
                    ],
                    "as": "ClearingDate"
                  },
                  {
                    "ref": [
                      "I",
                      "AccountingDocumentType"
                    ],
                    "as": "AccountingDocumentType"
                  },
                  {
                    "ref": [
                      "I",
                      "ChartOfAccounts"
                    ],
                    "as": "ChartOfAccounts"
                  },
                  {
                    "xpr": [
                      {
                        "xpr": [
                          "case",
                          "when",
                          {
                            "ref": [
                              "I",
                              "NetDueDate"
                            ]
                          },
                          "is",
                          "null",
                          "then",
                          {
                            "val": "Unknown"
                          },
                          "when",
                          {
                            "ref": [
                              "I",
                              "NetDueDate"
                            ]
                          },
                          ">=",
                          {
                            "ref": [
                              "I",
                              "PostingDate"
                            ]
                          },
                          "then",
                          {
                            "val": "Current"
                          },
                          "when",
                          {
                            "xpr": [
                              {
                                "ref": [
                                  "I",
                                  "PostingDate"
                                ]
                              },
                              "-",
                              {
                                "ref": [
                                  "I",
                                  "NetDueDate"
                                ]
                              }
                            ],
                            "cast": {
                              "type": "cds.Integer"
                            }
                          },
                          "<=",
                          {
                            "val": 30
                          },
                          "then",
                          {
                            "val": "1-30 days overdue"
                          },
                          "when",
                          {
                            "xpr": [
                              {
                                "ref": [
                                  "I",
                                  "PostingDate"
                                ]
                              },
                              "-",
                              {
                                "ref": [
                                  "I",
                                  "NetDueDate"
                                ]
                              }
                            ],
                            "cast": {
                              "type": "cds.Integer"
                            }
                          },
                          "<=",
                          {
                            "val": 60
                          },
                          "then",
                          {
                            "val": "31-60 days overdue"
                          },
                          "when",
                          {
                            "xpr": [
                              {
                                "ref": [
                                  "I",
                                  "PostingDate"
                                ]
                              },
                              "-",
                              {
                                "ref": [
                                  "I",
                                  "NetDueDate"
                                ]
                              }
                            ],
                            "cast": {
                              "type": "cds.Integer"
                            }
                          },
                          "<=",
                          {
                            "val": 90
                          },
                          "then",
                          {
                            "val": "61-90 days overdue"
                          },
                          "else",
                          {
                            "val": "90+ days overdue"
                          },
                          "end"
                        ],
                        "cast": {
                          "type": "cds.String",
                          "length": 30
                        }
                      }
                    ],
                    "as": "AgingBucket"
                  },
                  {
                    "xpr": [
                      {
                        "func": "SUM",
                        "args": [
                          {
                            "ref": [
                              "I",
                              "AmountInCompanyCodeCurrency"
                            ]
                          }
                        ],
                        "cast": {
                          "type": "cds.Decimal",
                          "precision": 34,
                          "scale": 4
                        }
                      }
                    ],
                    "as": "TotalAmountInCompanyCodeCurrency"
                  },
                  {
                    "xpr": [
                      {
                        "func": "SUM",
                        "args": [
                          {
                            "xpr": [
                              "case",
                              "when",
                              {
                                "ref": [
                                  "I",
                                  "AmountInCompanyCodeCurrency"
                                ]
                              },
                              "is",
                              "not",
                              "null",
                              "then",
                              {
                                "val": 1
                              },
                              "else",
                              {
                                "val": 0
                              },
                              "end"
                            ]
                          }
                        ],
                        "cast": {
                          "type": "cds.Integer"
                        }
                      }
                    ],
                    "as": "AmountInCompanyCodeCurrencyCount"
                  },
                  {
                    "xpr": [
                      {
                        "func": "SUM",
                        "args": [
                          {
                            "ref": [
                              "I",
                              "AmountInTransactionCurrency"
                            ]
                          }
                        ],
                        "cast": {
                          "type": "cds.Decimal",
                          "precision": 34,
                          "scale": 4
                        }
                      }
                    ],
                    "as": "TotalAmountInTransactionCurrency"
                  },
                  {
                    "xpr": [
                      {
                        "func": "SUM",
                        "args": [
                          {
                            "xpr": [
                              "case",
                              "when",
                              {
                                "ref": [
                                  "I",
                                  "AmountInTransactionCurrency"
                                ]
                              },
                              "is",
                              "not",
                              "null",
                              "then",
                              {
                                "val": 1
                              },
                              "else",
                              {
                                "val": 0
                              },
                              "end"
                            ]
                          }
                        ],
                        "cast": {
                          "type": "cds.Integer"
                        }
                      }
                    ],
                    "as": "AmountInTransactionCurrencyCount"
                  },
                  {
                    "xpr": [
                      {
                        "func": "COUNT",
                        "args": [
                          "*"
                        ],
                        "cast": {
                          "type": "cds.Integer"
                        }
                      }
                    ],
                    "as": "LineItemCount"
                  }
                ],
                "groupBy": [
                  {
                    "ref": [
                      "I",
                      "CompanyCode"
                    ]
                  },
                  {
                    "ref": [
                      "I",
                      "FiscalYear"
                    ]
                  },
                  {
                    "ref": [
                      "I",
                      "FiscalYearPeriod"
                    ]
                  },
                  {
                    "xpr": [
                      "case",
                      "when",
                      {
                        "ref": [
                          "I",
                          "FinancialAccountType"
                        ]
                      },
                      "=",
                      {
                        "val": "D"
                      },
                      "then",
                      {
                        "val": "Customer"
                      },
                      "when",
                      {
                        "ref": [
                          "I",
                          "FinancialAccountType"
                        ]
                      },
                      "=",
                      {
                        "val": "K"
                      },
                      "then",
                      {
                        "val": "Supplier"
                      },
                      "else",
                      {
                        "ref": [
                          "I",
                          "FinancialAccountType"
                        ]
                      },
                      "end"
                    ]
                  },
                  {
                    "ref": [
                      "I",
                      "GLAccount"
                    ]
                  },
                  {
                    "ref": [
                      "I",
                      "Customer"
                    ]
                  },
                  {
                    "ref": [
                      "I",
                      "Supplier"
                    ]
                  },
                  {
                    "ref": [
                      "I",
                      "ProfitCenter"
                    ]
                  },
                  {
                    "ref": [
                      "I",
                      "CostCenter"
                    ]
                  },
                  {
                    "ref": [
                      "I",
                      "CompanyCodeCurrency"
                    ]
                  },
                  {
                    "ref": [
                      "I",
                      "TransactionCurrency"
                    ]
                  },
                  {
                    "ref": [
                      "I",
                      "DebitCreditCode"
                    ]
                  },
                  {
                    "ref": [
                      "I",
                      "PostingDate"
                    ]
                  },
                  {
                    "ref": [
                      "I",
                      "NetDueDate"
                    ]
                  },
                  {
                    "ref": [
                      "I",
                      "ClearingDate"
                    ]
                  },
                  {
                    "ref": [
                      "I",
                      "AccountingDocumentType"
                    ]
                  },
                  {
                    "ref": [
                      "I",
                      "ChartOfAccounts"
                    ]
                  },
                  {
                    "xpr": [
                      "case",
                      "when",
                      {
                        "ref": [
                          "I",
                          "NetDueDate"
                        ]
                      },
                      "is",
                      "null",
                      "then",
                      {
                        "val": "Unknown"
                      },
                      "when",
                      {
                        "ref": [
                          "I",
                          "NetDueDate"
                        ]
                      },
                      ">=",
                      {
                        "ref": [
                          "I",
                          "PostingDate"
                        ]
                      },
                      "then",
                      {
                        "val": "Current"
                      },
                      "when",
                      {
                        "xpr": [
                          {
                            "ref": [
                              "I",
                              "PostingDate"
                            ]
                          },
                          "-",
                          {
                            "ref": [
                              "I",
                              "NetDueDate"
                            ]
                          }
                        ],
                        "cast": {
                          "type": "cds.Integer"
                        }
                      },
                      "<=",
                      {
                        "val": 30
                      },
                      "then",
                      {
                        "val": "1-30 days overdue"
                      },
                      "when",
                      {
                        "xpr": [
                          {
                            "ref": [
                              "I",
                              "PostingDate"
                            ]
                          },
                          "-",
                          {
                            "ref": [
                              "I",
                              "NetDueDate"
                            ]
                          }
                        ],
                        "cast": {
                          "type": "cds.Integer"
                        }
                      },
                      "<=",
                      {
                        "val": 60
                      },
                      "then",
                      {
                        "val": "31-60 days overdue"
                      },
                      "when",
                      {
                        "xpr": [
                          {
                            "ref": [
                              "I",
                              "PostingDate"
                            ]
                          },
                          "-",
                          {
                            "ref": [
                              "I",
                              "NetDueDate"
                            ]
                          }
                        ],
                        "cast": {
                          "type": "cds.Integer"
                        }
                      },
                      "<=",
                      {
                        "val": 90
                      },
                      "then",
                      {
                        "val": "61-90 days overdue"
                      },
                      "else",
                      {
                        "val": "90+ days overdue"
                      },
                      "end"
                    ]
                  }
                ],
                "where": [
                  {
                    "ref": [
                      "I",
                      "IsCommitment"
                    ]
                  },
                  "=",
                  {
                    "val": false
                  }
                ]
              }
            }
          }
        }
      }
    },
