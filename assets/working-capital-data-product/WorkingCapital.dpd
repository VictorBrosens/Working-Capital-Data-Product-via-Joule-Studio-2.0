        "protocol": "delta-sharing"
      }
    ],
    "target": {
      "definition": {
        "$schema": "https://sap.github.io/csn-interop-specification/spec-v1/csn-interop-effective.schema.json",
        "csnInteropEffective": "1.0",
        "$version": "2.0",
        "meta": {
          "__name": "WorkingCapital",
          "__namespace": "c.bdc.7p712k95j9gm6v0kj328bm8k5",
          "document": {
            "version": "1.0.0"
          }
        },
        "definitions": {
          "WorkingCapitalCube": {
            "kind": "entity",
            "@EndUserText.label": "Working Capital Analytics Cube",
            "@ObjectModel.tenantWideUniqueName": "WorkingCapitalCube",
            "elements": {
              "CompanyCode": {
                "@Analytics.dimension": true,
                "@EndUserText.label": "Company Code",
                "@EndUserText.heading": "Company Code",
                "@EndUserText.quickInfo": "Company Code",
                "@DataIntegration.dataUnavailable": true,
                "key": true,
                "type": "cds.String",
                "length": 4
              },
              "FiscalYear": {
                "@Analytics.dimension": true,
                "@EndUserText.label": "Fiscal Year",
                "@EndUserText.heading": "Fiscal Year",
                "@EndUserText.quickInfo": "Fiscal Year",
                "@DataIntegration.dataUnavailable": true,
                "key": true,
                "type": "cds.String",
                "length": 4
              },
              "FiscalYearPeriod": {
                "@Analytics.dimension": true,
                "@EndUserText.label": "Fiscal Year Period",
                "@EndUserText.heading": "Fiscal Year Period",
                "@EndUserText.quickInfo": "Fiscal Year Period",
                "@Semantics.fiscal.yearPeriod": true,
                "@DataIntegration.dataUnavailable": true,
                "key": true,
                "type": "cds.String",
                "length": 7
              },
              "FinancialAccountType": {
