            "ordId": "sap.s4com:apiResource:ProfitCenter:v1",
            "minVersion": "1.1.2"
          }
        ]
      },
      {
        "apiResources": [
          {
            "ordId": "sap.s4com:apiResource:Customer:v1",
            "minVersion": "1.2.0"
          }
        ]
      },
      {
        "apiResources": [
          {
            "ordId": "sap.s4com:apiResource:Supplier:v1",
            "minVersion": "1.5.0"
          }
        ]
      },
      {
        "apiResources": [
          {
            "ordId": "sap.s4com:apiResource:GeneralLedgerAccount:v1",
            "minVersion": "1.3.0"
          }
        ]
      }
    ],
    "outputPorts": [
