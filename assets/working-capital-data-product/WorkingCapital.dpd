{
  "definition": {
    "header": {
      "namespace": "c.bdc.7p712k95j9gm6v0kj328bm8k5",
      "version": "1.0.0",
      "type": "derived",
      "category": "other",
      "name": "WorkingCapital",
      "title": "Working Capital",
      "shortDescription": "Consolidated working capital data product covering Accounts Payable, Accounts Receivable, and Cash Conversion Cycle metrics with full master data enrichment for SAP Analytics Cloud planning",
      "description": "A derived analytical data product that consolidates AP and AR transactional data from SAP S/4HANA Cloud Private Edition with master data dimensions to expose pre-calculated working capital KPIs — Days Sales Outstanding (DSO), Days Payable Outstanding (DPO), and Cash Conversion Cycle (CCC = DSO − DPO) — together with AR open items by aging bucket and AP open items by payment due date. Designed for Accounts Payable and Accounts Receivable teams, consumed by SAP Analytics Cloud via DPQuery for working capital planning.",
      "responsible": "customer:vendor:Customer",
      "partOfPackage": "c.bdc.7p712k95j9gm6v0kj328bm8k5:package:dataProducts:v1"
    },
    "dpdInterop": "1.0",
    "meta": {
      "creator": "DPCA"
    },
    "inputPorts": [
      {
        "apiResources": [
          {
            "ordId": "sap.s4com:apiResource:EntryViewJournalEntry:v1",
            "minVersion": "1.1.3"
          }
        ]
      },
      {
        "apiResources": [
          {
            "ordId": "sap.s4com:apiResource:BillingDocument:v1",
            "minVersion": "1.6.0"
          }
        ]
      },
      {
        "apiResources": [
          {
            "ordId": "sap.s4com:apiResource:SupplierInvoice:v1",
            "minVersion": "1.5.0"
          }
        ]
      },
      {
        "apiResources": [
